# Copy this file to .env.production on the Proxmox VM and keep that file private.

# Keep this as 127.0.0.1 when the reverse proxy runs on the same VM/container.
# Set it to the blog container LAN IP, or 0.0.0.0, when Nginx Proxy Manager runs elsewhere.
HOST_BIND_IP=127.0.0.1

POSTGRES_PASSWORD=change-me-use-a-long-random-value
PAYLOAD_SECRET=change-me-use-a-long-random-value
UMAMI_APP_SECRET=change-me-use-a-long-random-value

# Optional until Listmonk is fully configured.
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_LIST_UUID=

# Set this after creating the website in Umami.
UMAMI_WEBSITE_ID=